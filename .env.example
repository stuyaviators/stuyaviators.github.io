# Copy to .env.local for local development. Never commit real secrets.
# On Vercel, set these in Project → Settings → Environment Variables.

# ── Site ─────────────────────────────────────────────────────────────────────
# Public URL used in metadata, sitemap and emails.
NEXT_PUBLIC_SITE_URL=https://stuyaviators.vercel.app
# Hide the header when scrolling down (ported from recode). "false" to disable.
NEXT_PUBLIC_HEADER_HIDE_ON_SCROLL=true

# ── Database (Neon Postgres via the Vercel Marketplace) ─────────────────────
# Vercel → Storage → your Neon database → Quickstart → "Show secret".
# The Vercel integration names these stuyaviators_DATABASE_URL; either name works.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# ── Auth (dashboard) ───────────────────────────────────────────────────────────
# Random 32+ byte secret: `openssl rand -base64 32`. Also salts rate-limit keys.
AUTH_SECRET=
# Google Cloud OAuth client (see docs/google-oauth-setup.md).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated emails seeded as admins on first sign-in (only while there
# are no admins yet). `pnpm db:seed` adds them without signing in.
ADMIN_EMAILS=
# LOCAL TESTING ONLY. "true" lets ANY Google account into the dashboard as an
# admin, without being on the officer list. Ignored unless NODE_ENV is
# "development" (so it never works on Vercel), and the dashboard shows a red
# banner while it's on. Leave it out otherwise.
DASHBOARD_OPEN_SIGNIN=

# ── Uploads ───────────────────────────────────────────────────────
# Vercel → Storage → Blob → your store → .env.local tab.
BLOB_READ_WRITE_TOKEN=

# ── Instagram feed (Behold) ─────────────────────────────────────────────────
# Public JSON feed, no key needed. See docs/behold-setup.md.
BEHOLD_FEED_URL=https://feeds.behold.so/CDSpFlcqkbtsbwbH8PR1

# ── Mailing list (Google Forms, club Gmail account) ─────────────────────────
# See docs/google-forms-setup.md. These are the current form's values.
GOOGLE_FORM_SIGNUP_ACTION=https://docs.google.com/forms/d/e/1FAIpQLScbjyhaEiBhMZPDi8TNQJZemMCSR9xfpChoRN0RP_sDhfS-ag/formResponse
GOOGLE_FORM_SIGNUP_NAME_ENTRY=entry.1248809368
GOOGLE_FORM_SIGNUP_EMAIL_ENTRY=entry.1701037871
GOOGLE_FORM_SIGNUP_FALLBACK_URL=https://forms.gle/vzSfXNKrsejNe1rd6
# Unsubscribe form: leave empty until it exists; links fall back to
# mailto:stuyaviators@gmail.com?subject=Unsubscribe.
GOOGLE_FORM_UNSUBSCRIBE_ACTION=
GOOGLE_FORM_UNSUBSCRIBE_EMAIL_ENTRY=
GOOGLE_FORM_UNSUBSCRIBE_FALLBACK_URL=
# Response spreadsheets, linked from the dashboard.
SIGNUP_SHEET_URL=
UNSUBSCRIBE_SHEET_URL=

# ── Submission alerts ───────────────────────────────────────────────────────
# Discord channel → Edit channel → Integrations → Webhooks → Copy URL.
# Secret: anyone with this URL can post to the channel.
DISCORD_WEBHOOK_URL=

# ── Meetings (Epsilon) ──────────────────────────────────────────────────────
# Epsilon only shows meetings to signed-in users. An officer's Epsilon session
# token (expires ~hourly). Phase 3 adds a dashboard setting to manage it.
EPSILON_ACCESS_TOKEN=
# Optional overrides (defaults shown).
EPSILON_API_URL=https://base.stuysu.org
EPSILON_ORG_URL=stuyaviators
