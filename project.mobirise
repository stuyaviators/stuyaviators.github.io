        "meta_descr": "Featuring flight sim demos, labs, presentations, competitions, and student-led courses, providing hands-on learning and opportunities to connect, experiment, and build aviation skills.",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": "5",
        "meta_image": "@PROJECT_PATH@/assets/images/img-6441.jpeg"
      },
