          "_name": "menu05",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"menu menu5\" group=\"Menu\" plugins=\"DropDown, TouchSwipe\" always-top global once=\"menu\" not-draggable position-absolute>\n\t<mbr-parameters>\n\t\t<header>Show/Hide</header>\n\t\t<input type=\"checkbox\" title=\"Logo\" name=\"showLogo\" checked>\n\t\t<input type=\"range\" title=\"Logo Size\" inline name=\"logoSize\" min=\"1\" max=\"5\" step=\"0.1\" value=\"4\" condition=\"showLogo\">\n\t\t<input type=\"checkbox\" title=\"Brand Name\" name=\"showBrand\" checked>\n\t\t<input type=\"checkbox\" title=\"Menu Items\" name=\"showItems\" checked>\n\t\t<select title=\"Menu Items Align\" name=\"contentAlign\" condition=\"showItems\">\n\t\t\t<option value=\"1\">Left</option>\n\t\t\t<option value=\"2\">Center</option>\n\t\t\t<option value=\"3\" selected>Right</option>\n\t\t</select>\n\t\t<input type=\"checkbox\" title=\"Button\" name=\"showButtons\" checked>\n\t\t<header>Styles</header>\n\t\t<input type=\"checkbox\" title=\"Collapsed\" name=\"collapsed\" condition=\"none\">\n\t\t<input type=\"checkbox\" title=\"Transparent\" name=\"transparent\" checked>\n\t\t<input type=\"checkbox\" title=\"Sticky\" name=\"sticky\">\n\t\t<input type=\"range\" title=\"Opacity\" name=\"opacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.8\" condition=\"transparent\">\n\t\t<input type=\"color\" title=\"Color\" name=\"menuBgColor\" value=\"#0f1b32\">\n\t\t<input type=\"color\" title=\"Hamburger\" name=\"hamburgerColor\" value=\"#deebff\">\n\t</mbr-parameters>\n\n\t<nav class=\"navbar navbar-dropdown\" mbr-class=\"{'navbar-fixed-top':sticky,\n                     'navbar-expand-lg':!collapsed,\n                     'collapsed':collapsed}\">\n\t\t<div class=\"container\">\n\t\t\t<div class=\"navbar-brand\">\n\t\t\t\t<span mbr-if=\"showLogo\" class=\"navbar-logo\">\n\t\t\t\t\t<a href=\"/\">\n\t\t\t\t\t\t<img src=\"@PROJECT_PATH@/assets/images/frame-1.png\" alt=\"logo-official\" mbr-style=\"{'height': logoSize + 'rem'}\">\n\t\t\t\t\t</a>\n\t\t\t\t</span>\n\t\t\t\t<span mbr-if=\"showBrand\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-caption-wrap\" data-toolbar=\"-mbrBtnMove,-mbrBtnAdd,-mbrBtnRemove,-iconFont\"><a class=\"navbar-caption text-warning text-primary\" data-app-selector=\".navbar-caption\" href=\"/\" data-app-placeholder=\"Type Text\">STUYAVIATORS</a></span>\n\t\t\t</div>\n\t\t\t<button class=\"navbar-toggler\" type=\"button\" data-toggle=\"collapse\" data-bs-toggle=\"collapse\" data-target=\"#navbarSupportedContent\" data-bs-target=\"#navbarSupportedContent\" aria-controls=\"navbarNavAltMarkup\" aria-expanded=\"false\" aria-label=\"Toggle navigation\" mbr-if=\"showItems || showButtons\">\n\t\t\t\t<div class=\"hamburger\">\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t\t<span></span>\n\t\t\t\t</div>\n\t\t\t</button>\n\t\t\t<div class=\"collapse navbar-collapse\" id=\"navbarSupportedContent\" mbr-if=\"showItems || showButtons\">\n\t\t\t\t<ul mbr-menu class=\"navbar-nav nav-dropdown\" mbr-theme-style=\"display-4\" mbr-if=\"showItems\" mbr-class=\"{'nav-right': !showButtons,'navbar-nav-top-padding': isPublish && !showBrand && !showLogo}\"><li class=\"nav-item dropdown\">\n\t\t\t\t\t\t<a class=\"nav-link link dropdown-toggle text-warning show\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">ABOUT</a><div class=\"dropdown-menu show\" aria-labelledby=\"dropdown-787\" data-bs-popper=\"none\"><a class=\"dropdown-item show text-warning text-primary\" href=\"/mission\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"false\">Our Mission<br></a><a class=\"dropdown-item show text-warning text-primary\" href=\"/story\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Our Story<br></a><a class=\"dropdown-item show text-warning text-primary\" href=\"/charter\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Club Charter<br></a><a class=\"dropdown-item show text-warning text-primary\" href=\"/expectations\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Rules &amp; Expectations</a></div>\n\t\t\t\t\t</li><li class=\"nav-item dropdown\"><a class=\"nav-link link dropdown-toggle text-warning\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">EXPLORE</a><div class=\"dropdown-menu\" aria-labelledby=\"dropdown-666\"><a class=\"dropdown-item text-warning text-primary\" href=\"/meetings\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Meetings<br></a><a class=\"dropdown-item text-warning text-primary\" href=\"/opportunities\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Opportunities</a><a class=\"dropdown-item text-warning text-primary\" href=\"/scholarships\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Scholarships</a><a class=\"dropdown-item text-warning text-primary\" href=\"/careers\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Future Careers</a></div></li>\n\t\t\t\t\t<li class=\"nav-item dropdown open\">\n\t\t\t\t\t\t<a class=\"nav-link link dropdown-toggle text-warning show\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" aria-expanded=\"true\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\">GET INVOLVED</a><div class=\"dropdown-menu show\" aria-labelledby=\"dropdown-863\" data-bs-popper=\"none\"><a class=\"dropdown-item text-warning text-primary\" href=\"/flight-crew\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Join the Flight Crew<br></a><a class=\"dropdown-item text-warning text-primary\" href=\"/share-story\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Share Your Story</a><a class=\"dropdown-item text-warning text-primary\" href=\"/highlights\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Feature Photos &amp; Videos</a></div>\n\t\t\t\t\t</li>\n\t\t\t\t\t<li class=\"nav-item dropdown\">\n\t\t\t\t\t\t<a class=\"nav-link link dropdown-toggle text-warning\" href=\"https://mobiri.se\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\" data-toggle=\"dropdown-submenu\" data-bs-toggle=\"dropdown\" data-bs-auto-close=\"outside\" aria-expanded=\"false\">CONNECT</a><div class=\"dropdown-menu\" aria-labelledby=\"dropdown-754\"><a class=\"dropdown-item text-warning text-primary\" href=\"/socials\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Socials</a><a class=\"dropdown-item text-warning text-primary\" href=\"/contact-us\" data-app-selector=\".nav-link,.dropdown-item\" data-app-placeholder=\"Type Text\">Contact Us</a></div>\n\t\t\t\t\t</li></ul>\n\t\t\t\t<div mbr-if=\"showButtons\" mbr-buttons mbr-theme-style=\"display-4\" class=\"navbar-buttons mbr-section-btn\"><a class=\"btn btn-warning-outline\" href=\"https://epsilon.stuysu.org/stuyaviators\" data-app-placeholder=\"Type Text\" target=\"_blank\">JOIN NOW</a></div>\n\t\t\t</div>\n\t\t</div>\n\t</nav>\n</section>",
