              "color": "#000000"
            },
            ".mbr-section-subtitle": {
              "color": "#000000"
            },
            ".mbr-section-title": {
              "color": "#000000",
              "text-align": "center"
            }
          },
          "_name": "article12",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"article12\" group=\"Article\">    \n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\">\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"3\">\n        <input type=\"range\" name=\"textWidth\" title=\"Width\" min=\"4\" max=\"12\" value=\"9\" step=\"1\">\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\" checked>\n        <input type=\"checkbox\" title=\"Subtitle\" name=\"showSubtitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\" checked>\n        <header>Background</header>\n        <input type=\"color\" title=\"Color\" name=\"bgColor\" value=\"#deebff\">\n    </mbr-parameters>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\">\n            <div class=\"col-md-12 col-lg-{{textWidth}}\">\n                <h3 class=\"mbr-section-title mbr-fonts-style mb-4 mt-0\" mbr-if=\"showTitle\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\"><b>CANCELLATIONS &amp; RESCHEDULING</b></h3>\n                <h4 class=\"mbr-section-subtitle mbr-fonts-style mb-4\" mbr-if=\"showSubtitle\" data-app-selector=\".mbr-section-subtitle\" mbr-theme-style=\"display-5\">The storytelling magic of photos\n                </h4>\n                <p class=\"mbr-text mbr-fonts-style\" mbr-if=\"showText\" data-app-selector=\".mbr-text\" mbr-theme-style=\"display-7\">While StuyAviators strives to maintain a consistent and reliable meeting schedule, there may be times when meetings must be cancelled, postponed, or adjusted. Cancellations may occur for a variety of reasons, including but not limited to leadership availability, unexpected school events, inclement weather, or the sensitivity of planned activities in light of recent real-world aviation incidents (for example, postponing a crash investigation activity if an actual crash has recently taken place).<br><br>Whenever possible, members will be notified of a cancellation or rescheduling at least 12 hours before the scheduled start time. Notices will be sent via the club’s official communication channels (e.g., Discord, email, or Epsilon). If no members of the leadership team are available to attend, the meeting will be cancelled or rescheduled, and members will be informed promptly.<br><br>Cancelled meetings may be rescheduled for a later date or substituted with an alternative activity, depending on the nature of the cancellation. Members are encouraged to stay flexible and understanding, as cancellations and adjustments are made with respect to both member experience and broader circumstances.</p>\n            </div>\n        </div>\n    </div>\n</section>",
          "_anchor": "article12-12",
          "_cid": "uVAwKNsbDy",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        }
      ]
    }
  }
}